; Hill Motion — проект для Godot 4.3.
; Файл намеренно не содержит настроек Godot 3.
config_version=5

[application]
config/name="Hill Motion: Эволюция"
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.3")

[autoload]
Config="*res://scripts/config.gd"

[display/window]
size/viewport_width=1280
size/viewport_height=720
size/window_width_override=1280
size/window_height_override=720
stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false

[physics/2d]
default_gravity=1400.0
